{
  // Default council. Each seat runs every lens that has no override.
  "seats": [
    { "harness": "claude", "model": "opus",             "thinking": "high" },
    { "harness": "auto",   "model": "cubbit/mimir-pro", "thinking": "high" },
    { "harness": "auto",   "model": "cubbit/mimir",     "thinking": "high" }
  ],
  // "per-seat" = 1 child per seat runs all its lenses; "per-lens" = 1 child per seat and lens.
  // The effort level overrides this: low and medium run per-seat, high and max per-lens.
  "round1": "per-seat",
  // Per-lens override. A lens with "seats" uses only those seats. A lens needs 2 or more seats.
  "lenses": {
    "security": { "seats": [
      { "harness": "claude", "model": "claude-fable-5-1", "thinking": "max" },
      { "harness": "pi",     "model": "cubbit/mimir-pro", "thinking": "high" }
    ]}
  },
  // Clusters findings and writes the final review text.
  "judge": { "harness": "claude", "model": "opus", "thinking": "high" },
  // Settles split votes. "auto" = use jev when the jev CLI is on PATH.
  "decider": { "kind": "auto", "confidence": 0 },
  "loop": {
    "authors_ignore": ["dependabot[bot]", "renovate[bot]"],
    "max_prs_per_run": 10,
    "max_review_rounds": 3,
    "max_replies_per_thread": 2
  },
  // Limits per child: a seat may set its own "max_turns" and "timeout_minutes", a lens its own "max_turns".
  // max_turns reaches claude seats only (--max-turns); pi has no such flag, so the timeout bounds it.
  "review": { "max_turns": 30, "timeout_minutes": 10 },
  // PR hygiene check (title, body, linked issue, changelog). Repo level may set it too.
  "hygiene": { "enabled": true }
}
