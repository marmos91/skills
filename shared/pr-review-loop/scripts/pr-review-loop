#!/bin/sh
# pr-review-loop [owner/repo]                          one loop run (repeat it with /loop, cron or launchd)
# pr-review-loop pause|resume [owner/repo]
# pr-review-loop answer [<id> <option>] [--repo owner/repo]
# Every command finds the repo the same way: the argument (or --repo), else this folder's GitHub remote.
set -e
engine="$(dirname "$(realpath "$0")")/../../pr-review/scripts"
case "${1:-}" in
  pause|resume|answer) exec "$engine/pr-review" "$@" ;;
  *) exec "$engine/pr-review" tick "$@" ;;
esac
