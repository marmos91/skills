#!/bin/sh
# pr-respond findings|decide|decline|fixed|summary|scan ... [--pr <n|url>]   steps of the pr-respond skill
set -e
# node, not realpath(1): realpath is not POSIX and is missing on older macOS
here="$(node -e 'const p=require("node:path"),f=require("node:fs");console.log(p.dirname(f.realpathSync(process.argv[1])))' "$0")"
[ "$1" = scan ] && { shift; exec node "$here/scan.mjs" "$@"; }
engine="$here/../../pr-review/scripts"
[ -x "$engine/pr-review" ] || { echo "pr-respond: cannot find the pr-review engine at $engine" >&2; exit 1; }
exec "$engine/pr-review" respond "$@"
