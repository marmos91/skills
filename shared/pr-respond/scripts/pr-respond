#!/bin/sh
# pr-respond findings|decide|decline|fixed|summary ... [--pr <n|url>]   steps of the pr-respond skill
set -e
# node, not realpath(1): realpath is not POSIX and is missing on older macOS
engine="$(node -e 'const p=require("node:path"),f=require("node:fs");console.log(p.resolve(p.dirname(f.realpathSync(process.argv[1])),"../../pr-review/scripts"))' "$0")"
[ -x "$engine/pr-review" ] || { echo "pr-respond: cannot find the pr-review engine at $engine" >&2; exit 1; }
exec "$engine/pr-review" respond "$@"
