export const meta = {
  name: 'audit-ai-codebase',
  description: 'Multi-wave, multi-agent audit of an AI-developed repo: recon, reference scan, lens×area finders, adversarial verify, report.md',
  phases: [
    { title: 'Recon', detail: 'map stack + partition into areas (code-explorer)' },
    { title: 'Reference', detail: 'find official/reference impls via web search' },
    { title: 'Audit', detail: 'one finder per (lens, area), parallel; distinct lens per wave' },
    { title: 'DeepWaves', detail: 'completeness re-hunt (on by default), dedup vs seen' },
    { title: 'Verify', detail: 'skeptics refute each finding: confirmed-from-source + reachable (not dead code) + not spec-correct' },
    { title: 'Report', detail: 'writer agent emits report.md' },
  ],
}

// ---- inputs -------------------------------------------------------------
const A = (typeof args === 'string' ? JSON.parse(args) : (args || {}))
const repoPath = (A.repoPath) || '.'
const depth = (A.depth) || 'standard'   // quick | standard | deep
// `passes` = how many distinct bug-class waves to run. Defaults scale with depth.
// Caller can override explicitly: A.passes.
const DEFAULT_PASSES = { quick: 3, standard: 6, deep: 8 }
const requestedPasses = (A.passes) || DEFAULT_PASSES[depth] || 6
const SKEPTICS = depth === 'deep' ? 3 : depth === 'quick' ? 1 : 2
// Stack/language best-practice guidance, supplied by the driver after loading
// stack-specific skills (e.g. claude-api, frontend-design, a Go/Python idiom skill).
const stackGuidance = (A.stackGuidance) || ''

// --- Fan-out caps (workflow agent cap is 1000; stay well under) ----------
// Finder agents = areas × passes. Verify is BATCHED (not per-finding) so the
// run terminates regardless of how many findings turn up.
const MAX_FINDER_AGENTS = (A.maxFinderAgents) || 120
const MAX_VERIFY = (A.maxVerify) || 300   // cap findings sent to verify
const VERIFY_BATCH = 10                               // findings per verify agent
// Terse instruction appended to every finder/verify prompt — caveman-style,
// cuts token volume hard without losing the file:line + fix substance.
const TERSE = '\n\nBe terse caveman-style: drop articles/filler. Keep file:line, exact symbols, and the fix. Fragments OK. No preamble.'
// Per-role models — cheap tiers for high-volume/low-judgement work, save tokens.
// Override via A.models. Bulk finders + verify run on Sonnet; trivial probe on Haiku.
const M = Object.assign({ probe: 'haiku', recon: 'sonnet', reference: 'sonnet', finder: 'sonnet', deep: 'sonnet', verify: 'sonnet', report: 'sonnet' }, (A.models) || {})

// --- Durable cross-session resume ----------------------------------------
// Finder cells + verify verdicts are written to disk under CACHE; re-running
// (even in a NEW session) reads them back and only does missing work.
// Pass A.fresh=true to ignore the cache and start clean.
const CACHE = (A.cacheDir) || `${repoPath}/.audit-cache`
const resume = !(A.fresh)
const keyOf = (f) => `${(f && f.file) || ''}:${(f && f.line) || ''}:${(f && f.title) || ''}`.toLowerCase()
const cellKey = (lensKey, areaKey) => `${lensKey}__${areaKey}`.replace(/[^\w.-]/g, '_')

// ---- Incremental report writer (no single mega-Write) -------------------
// Emitting a 200+ finding report in ONE Write blocks for many minutes (model
// streams the whole blob token-by-token into a single tool call → looks like a
// hang, can trip the no-output watchdog; a real run stalled 17+ min). Instead:
// one init agent writes the header, then one agent PER chunk APPENDS its slice.
// Appends MUST be serialized (concurrent appends to one file corrupt it) — the
// pipeline runs chunks strictly in order. Each agent only formats its own slice.
const REPORT_CHUNK = 15
async function writeReportIncremental({ path, headerPrompt, items, fmtItem, tail }) {
  await agent(headerPrompt + `\nThen STOP — append no findings. Confirm the path after writing.`,
    { label: 'report-init', phase: 'Report', model: M.report })
  const chunks = []
  for (let i = 0; i < items.length; i += REPORT_CHUNK) chunks.push({ idx: chunks.length, items: items.slice(i, i + REPORT_CHUNK) })
  await pipeline(chunks, async (chunk) => {
    await agent(
      `APPEND a Markdown section to the EXISTING file ${path} (it already has a header and may already have earlier sections). Do NOT overwrite: Read the file, then Write it back with these ${chunk.items.length} findings appended at the very END.\n\n` +
      `Emit for EACH finding exactly:\n${fmtItem}\n\nFindings (JSON):\n${JSON.stringify(chunk.items)}\n\n` +
      `Preserve order. Add nothing else (no new top-level headings, no summary). Confirm after writing.` + TERSE,
      { label: `report-chunk-${chunk.idx}`, phase: 'Report', model: M.report }).catch(() => {})
    return chunk.idx
  })
  if (tail) await agent(tail.prompt, { label: 'report-tail', phase: 'Report', model: M.report }).catch(() => {})
}

// Lens rotation — each wave hunts ONE dimension across ALL areas, so wave N
// finds a different bug class than wave N-1. Ordered by signal density.
const LENSES = [
  { key: 'bugs',      agentType: 'feature-dev:code-reviewer', hunt: 'Logic errors, edge cases, race conditions, nil/None derefs, broken error handling, off-by-one, resource leaks, incorrect concurrency.' },
  { key: 'security',  agentType: 'feature-dev:code-reviewer', hunt: 'Injection, hardcoded secrets/keys, missing auth/authz, unsafe deserialization, path traversal, SSRF, vulnerable or hallucinated dependencies.' },
  { key: 'slop',      agentType: 'feature-dev:code-reviewer', hunt: 'AI-slop: hallucinated APIs/imports/deps that do not exist, invented functions, fabricated or no-op test assertions, stubs/TODOs passing as done, plausible-but-wrong logic, copy-paste drift.' },
  { key: 'perf',      agentType: 'feature-dev:code-reviewer', hunt: 'Performance gaps: hot-path allocations, N+1, O(n^2) where O(n) exists, unbounded buffers, missing streaming/pooling, redundant recomputation, sync work that should be batched.' },
  { key: 'structure', agentType: 'feature-dev:code-architect', hunt: 'Design-pattern & best-practice violations for the DETECTED language(s)/stack. Judge against established idioms, design patterns, and anti-patterns for THIS language — e.g. Go: internal/ vs pkg/ layout, package naming, accept-interfaces/return-structs, interface-at-consumer, error wrapping (%w), context propagation, no naked concurrency; Python: package layout, type hints, dataclasses/protocols, context managers, no mutable defaults; TS/JS: module boundaries, no any-soup, proper async. Flag SOLID violations, god objects, leaky abstractions, wrong-layer logic, and missing canonical patterns the stack expects. Cite the specific idiom/pattern being violated.' },
  { key: 'bloat',     agentType: 'feature-dev:code-reviewer', hunt: 'Dead code, unused abstractions, speculative generality, duplication, needless indirection, over-engineering typical of AI output.' },
  { key: 'comments',  agentType: 'feature-dev:code-reviewer', hunt: 'Useless comments: redundant restatements of code, AI narration ("Now we loop over..."), stale/misleading comments, commented-out code blocks.' },
  { key: 'gaps',      agentType: 'feature-dev:code-reviewer', hunt: 'Feature/correctness gaps vs the reference implementation provided in context. What does the real product do that this code omits or gets wrong?' },
]
// A.lenses (array of lens keys) selects EXACTLY those lenses, in LENSES order,
// regardless of position — lets a caller run e.g. only perf/structure/bloat/
// comments/gaps. Otherwise fall back to the first `requestedPasses` lenses.
const selectedLenses = (Array.isArray(A.lenses) && A.lenses.length)
  ? LENSES.filter((l) => A.lenses.includes(l.key))
  : LENSES.slice(0, Math.min(requestedPasses, LENSES.length))
const passes = selectedLenses.length
const MAX_AREAS = Math.max(4, Math.floor(MAX_FINDER_AGENTS / passes))   // bound finder fan-out

// ---- schemas ------------------------------------------------------------
const RECON = {
  type: 'object', additionalProperties: false,
  required: ['stack', 'productType', 'sizeClass', 'areas'],
  properties: {
    stack: { type: 'string', description: 'languages + frameworks + build tools detected' },
    productType: { type: 'string', description: 'what this product IS, for reference search (e.g. "S3-compatible object store", "NFS server")' },
    idiomRules: { type: 'string', description: 'stack-specific best-practice/layout rules to judge structure against' },
    sizeClass: { type: 'string', enum: ['small', 'medium', 'large'], description: 'small <~10k LOC, medium, large >~100k LOC or many subsystems' },
    mapPath: { type: 'string', description: 'path to the written AUDIT-MAP.md (large repos only)' },
    areas: {
      type: 'array', minItems: 1,
      items: { type: 'object', additionalProperties: false, required: ['key', 'path', 'desc'],
        properties: {
          key: { type: 'string' }, path: { type: 'string' }, desc: { type: 'string' },
          importance: { type: 'string', enum: ['critical', 'high', 'normal'], description: 'criticality — critical/high areas get priority + more passes' },
        } },
    },
  },
}
const FINDINGS = {
  type: 'object', additionalProperties: false, required: ['findings'],
  properties: { findings: { type: 'array', items: {
    type: 'object', additionalProperties: false,
    required: ['title', 'file', 'line', 'severity', 'what', 'why', 'fix'],
    properties: {
      title: { type: 'string' }, file: { type: 'string' }, line: { type: 'integer' },
      severity: { type: 'string', enum: ['HIGH', 'MED', 'LOW'] },
      what: { type: 'string' }, why: { type: 'string' }, fix: { type: 'string' },
    } } } },
}
const VERDICT = {
  type: 'object', additionalProperties: false, required: ['real', 'reason'],
  properties: { real: { type: 'boolean' }, reason: { type: 'string' },
    severity: { type: 'string', enum: ['HIGH', 'MED', 'LOW'] } },
}
const REFERENCE = {
  type: 'object', additionalProperties: false, required: ['checklist'],
  properties: { checklist: { type: 'string', description: 'expected behaviors/features with source URLs' },
    sources: { type: 'array', items: { type: 'string' } } },
}

// ---- Seed loading (shared by deepOnly + verifySeed) ----------------------
// A seed is a prior run's findings (e.g. salvaged from an interrupted run's
// journal.jsonl). Loading it through ONE agent forces the model to echo every
// finding token-by-token — on a 1000+ finding seed that is slow enough to trip
// the stream watchdog and stall the whole run. So: a cheap probe counts the
// findings, then CHUNKED loaders each shell-slice ≤150 and run in parallel.
// Prefer passing the seed inline via A.seed (no agent at all) when you already
// have it parsed in the orchestrator.
const SEED_ITEM = { type: 'object', additionalProperties: true }
async function loadSeed(phaseName) {
  if (Array.isArray(A.seed) && A.seed.length) return A.seed
  if (!A.seedPath) return []
  const probe = await agent(
    `Run a shell command to count the findings in the JSON at ${A.seedPath}. The file is either a JSON array of findings or an object with a "findings" (or "result.findings") array. Use: python3 -c "import json;d=json.load(open('${A.seedPath}'));a=d if isinstance(d,list) else (d.get('findings') or d.get('result',{}).get('findings') or []);print(len(a))". Return the integer count.`,
    { label: 'seed-count', phase: phaseName, model: M.probe,
      schema: { type: 'object', additionalProperties: false, required: ['count'], properties: { count: { type: 'integer' } } } }).catch(() => ({ count: 0 }))
  const n = probe.count || 0
  if (!n) return []
  const CHUNK = 150
  const ranges = []
  for (let i = 0; i < n; i += CHUNK) ranges.push([i, Math.min(i + CHUNK, n)])
  const parts = await parallel(ranges.map(([a, b]) => () =>
    agent(
      `Run this shell command and return its output verbatim as the "seed" array — do NOT summarize or reason over the items, just echo what the command prints:\n` +
      `python3 -c "import json;d=json.load(open('${A.seedPath}'));a=d if isinstance(d,list) else (d.get('findings') or d.get('result',{}).get('findings') or []);import sys;json.dump([{k:x.get(k) for k in ('file','line','title','what','why','fix','area','dimension','severity')} for x in a[${a}:${b}]],sys.stdout)"`,
      { label: `seed-load-${a}`, phase: phaseName, model: M.probe,
        schema: { type: 'object', additionalProperties: false, required: ['seed'], properties: { seed: { type: 'array', items: SEED_ITEM } } } }).catch(() => ({ seed: [] }))
      .then((r) => r.seed || [])
  ))
  return parts.flat()
}

// ---- verifySeed mode: run ONLY the adversarial verify gate on a seed ------
// Recovery path for an interrupted run: its raw finder output is salvageable
// but UNVERIFIED. This loads that seed, runs the same confirmed-from-source +
// reachable + not-spec-correct gate against a CLEAN repoPath (use an immutable
// `git worktree add --detach origin/<branch>`), re-grades severity, and writes
// report-verified.md. No recon / finders / deepwaves. Optionally restrict to
// the worst severities via A.verifySeverities (e.g. ["HIGH","MED"]).
if (A.verifySeed) {
  phase('Verify')
  const vrank = { HIGH: 0, MED: 1, LOW: 2 }
  // A seed of a few hundred findings is ~400KB of JSON. Routing that through
  // loader agents does NOT work: asked to echo 142 findings verbatim, the model
  // summarizes instead and silently returns a handful (a real run lost 276 of
  // 284 that way). So in seedPath mode NOTHING echoes the seed — a probe counts
  // it, batches are index ranges, and each verify agent shell-reads its OWN
  // ~10-item slice. Only CONFIRMED findings come back, which is bounded output.
  const inlineSeed = (Array.isArray(A.seed) && A.seed.length)
    ? ((Array.isArray(A.verifySeverities) && A.verifySeverities.length)
        ? A.seed.filter((f) => A.verifySeverities.includes(f.severity)) : A.seed.slice())
    : null
  if (inlineSeed) inlineSeed.sort((a, b) => (vrank[a.severity] ?? 3) - (vrank[b.severity] ?? 3))
  // Shared load+filter+sort prologue so the count and every slice agree on order.
  // Single quotes only — the whole -c argument is double-quoted in the prompt.
  const sevFilter = (Array.isArray(A.verifySeverities) && A.verifySeverities.length)
    ? `;a=[x for x in a if x.get('severity') in '${A.verifySeverities.join(',')}'.split(',')]` : ''
  const PY = `import json,sys;d=json.load(open('${A.seedPath}'));a=d if isinstance(d,list) else (d.get('findings') or d.get('result',{}).get('findings') or [])${sevFilter};r={'HIGH':0,'MED':1,'LOW':2};a.sort(key=lambda x:r.get(x.get('severity'),3))`
  let vcount = 0
  if (inlineSeed) vcount = inlineSeed.length
  else if (A.seedPath) {
    const probe = await agent(
      `Run exactly this and return the integer it prints:\npython3 -c "${PY};print(len(a))"`,
      { label: 'seed-count', phase: 'Verify', model: M.probe,
        schema: { type: 'object', additionalProperties: false, required: ['count'], properties: { count: { type: 'integer' } } } }).catch(() => ({ count: 0 }))
    vcount = probe.count || 0
  }
  log(`verifySeed: ${vcount} findings to verify against ${repoPath}${inlineSeed ? ' (inline seed)' : ' (agents self-load slices)'}`)
  const vVB = { type: 'object', additionalProperties: false, required: ['verdicts'], properties: { verdicts: { type: 'array', items: { type: 'object', additionalProperties: false, required: ['idx', 'real'], properties: { idx: { type: 'integer' }, real: { type: 'boolean' }, reachable: { type: 'boolean' }, severity: { type: 'string', enum: ['HIGH', 'MED', 'LOW'] }, reason: { type: 'string' }, file: { type: 'string' }, line: { type: 'integer' }, title: { type: 'string' }, fix: { type: 'string' }, area: { type: 'string' }, dimension: { type: 'string' } } } } } }
  const vbatches = []
  for (let i = 0; i < vcount; i += VERIFY_BATCH) vbatches.push([i, Math.min(i + VERIFY_BATCH, vcount)])
  const vres = await parallel(vbatches.map(([lo, hi], bi) => () => {
    const batch = inlineSeed ? inlineSeed.slice(lo, hi) : null
    const claims = batch
      ? `\n\nClaims:\n` + batch.map((f, j) => `[idx ${j}] (${f.severity} ${f.dimension || '?'}) ${f.file}:${f.line} — ${f.title}\n   what: ${f.what || ''}\n   why: ${f.why || ''}`).join('\n')
      : `\n\nFIRST run exactly this to load YOUR batch of claims — do NOT echo its output back, just read it:\n` +
        `python3 -c "${PY};json.dump(a[${lo}:${hi}],sys.stdout,indent=1)"\n` +
        `That prints a JSON array of ${hi - lo} claims; idx is the position in THAT array (0-based). Each has file, line, title, what, why, fix, area, dimension, severity.`
    return agent(
      `Adversarial verify in repo ${repoPath} (a clean checkout of the target branch). For EACH claim READ the code at file:line and try HARD to REFUTE. Set real=true ONLY if ALL hold: (1) CONFIRMED FROM SOURCE — code exists as described (not a misread); (2) REACHABLE — symbol is constructed/called from a non-test entrypoint (grep callers; dead/test-only ⇒ real=false, reachable=false); (3) NOT ALREADY FIXED — still present on this tree (seeds from older trees may be stale); (4) NOT SPEC-CORRECT / NOT NEGLIGIBLE — behavior is genuinely wrong, or the perf cost is materially significant on a hot path (micro-opt with no measurable impact ⇒ real=false or downgrade severity). Default real=false. Re-grade severity if the seed label is overstated. reason = deciding evidence.\n` +
      `Return ONE verdict per claim. For every verdict ALSO copy through that claim's file, line, title, fix, area and dimension so the report can be built without re-reading the seed.` +
      claims + TERSE,
      { label: `verify-seed-${bi}`, phase: 'Verify', model: M.verify, schema: vVB }).catch(() => ({ verdicts: [] }))
      .then((r) => (((r && r.verdicts) || [])).map((v) => {
        const f = (batch && batch[v.idx]) || {}
        const m = { ...f, ...(v.file ? { file: v.file } : {}), ...(v.line ? { line: v.line } : {}), ...(v.title ? { title: v.title } : {}), ...(v.fix ? { fix: v.fix } : {}), ...(v.area ? { area: v.area } : {}), ...(v.dimension ? { dimension: v.dimension } : {}) }
        if (!m.title) return null
        return { ...m, severity: v.severity || m.severity || 'MED', confirmed: !!v.real && v.reachable !== false, verdict: v.reason || '' }
      }).filter(Boolean))
  }))
  const vconfirmed = vres.flat().filter((f) => f.confirmed).sort((a, b) => (vrank[a.severity] ?? 3) - (vrank[b.severity] ?? 3))
  log(`verifySeed: ${vcount} judged → ${vconfirmed.length} confirmed real`)

  phase('Report')
  const vsev = (s) => vconfirmed.filter((f) => f.severity === s).length
  await writeReportIncremental({
    path: `${repoPath}/report-verified.md`,
    items: vconfirmed,
    headerPrompt:
      `Write the START of a Markdown report to ${repoPath}/report-verified.md using the Write tool (create/overwrite). These are VERIFIED findings salvaged from a prior/interrupted audit and re-checked against this clean tree. Write ONLY:\n` +
      `# Verified Re-Audit — <repo basename>\n${vcount} judged → ${vconfirmed.length} confirmed · ${vsev('HIGH')} HIGH / ${vsev('MED')} MED / ${vsev('LOW')} LOW\n\n## Findings\n\n`,
    fmtItem: `### [SEV] <title> · area: <area>\n- **Where:** \`<file>:<line>\`\n- **Why real:** <verdict>\n- **Fix:** <fix>`,
  })

  const vby = (k) => vconfirmed.reduce((m, f) => ((m[f[k]] = (m[f[k]] || 0) + 1), m), {})
  return {
    mode: 'verifySeed',
    reportPath: `${repoPath}/report-verified.md`,
    judged: vcount,
    confirmed: vconfirmed.length,
    totals: { HIGH: vconfirmed.filter((f) => f.severity === 'HIGH').length, MED: vconfirmed.filter((f) => f.severity === 'MED').length, LOW: vconfirmed.filter((f) => f.severity === 'LOW').length },
    byArea: vby('area'),
    findings: vconfirmed,
  }
}

// ---- deepOnly mode: run ONLY DeepWaves against an existing audit ---------
// Seeds dedup + critic context from a prior audit's findings (A.seed) and
// skips recon/reference/finders entirely. Re-hunts cross-file/integration bugs
// on a completed audit without redoing the expensive lens×area sweep. The main
// audit path below is left untouched (this branch returns early).
if (A.deepOnly) {
  const seed = await loadSeed('DeepWaves')
  const dseen = new Set(seed.map(keyOf))
  const dfresh = []
  const dareas = (A.areas && A.areas.length)
    ? A.areas
    : [...new Set(seed.map((f) => f.area).filter(Boolean))].map((k) => ({ key: k, desc: k, path: repoPath }))
  const stack = A.stack || A.stackGuidance || ''
  log(`deepOnly: seeded ${seed.length} prior findings across ${dareas.length} areas; running DeepWaves only`)

  phase('DeepWaves')
  const DEEP_ROUNDS_DEFAULT = (A.deepRounds != null) ? A.deepRounds : 3
  const DEEP_MAX = 8
  let dry = 0, rounds = 0
  while (dry < 2 && rounds < DEEP_MAX) {
    const headroom = budget.total ? budget.remaining() > 80_000 : false
    if (rounds >= DEEP_ROUNDS_DEFAULT && !headroom) break
    rounds++
    const seenTitles = [...seed, ...dfresh].slice(-80).map((f) => `- ${f.area}/${f.dimension || '?'}: ${f.title}`).join('\n')
    const critic = await agent(
      `${dareas.map((a) => `${a.key}: ${a.desc}`).join('\n')}\n\nStack: ${stack}\n\n` +
      `An audit already found ${seed.length + dfresh.length} issues. Already-found (do NOT re-report):\n${seenTitles}\n\n` +
      `Find DIFFERENT issues earlier waves missed in repo ${repoPath} — especially CROSS-FILE / INTEGRATION bugs: caller/callee assumption mismatches, invariants broken across packages, error/lifecycle/concurrency bugs that only surface when components interact, and dead/unreachable code paths. Read the actual source. Concrete file:line. Empty list if none genuinely remain.` + TERSE,
      { label: `deep-wave-${rounds}`, phase: 'DeepWaves', model: M.deep, schema: FINDINGS }).catch(() => null) || { findings: [] }
    const add = ((critic && critic.findings) || []).map((f) => ({ ...f, dimension: f.dimension || 'bugs', area: f.area || 'cross' }))
      .filter((f) => { const k = keyOf(f); if (dseen.has(k)) return false; dseen.add(k); return true })
    if (!add.length) { dry++; continue }
    dry = 0; dfresh.push(...add)
    log(`Deep wave ${rounds}: +${add.length} new (total new ${dfresh.length})`)
  }

  // verify the NEW findings only (hardened: confirmed-from-source + reachable + not spec-correct)
  phase('Verify')
  const drank = { HIGH: 0, MED: 1, LOW: 2 }
  dfresh.sort((a, b) => (drank[a.severity] ?? 3) - (drank[b.severity] ?? 3))
  const dVB = { type: 'object', additionalProperties: false, required: ['verdicts'], properties: { verdicts: { type: 'array', items: { type: 'object', additionalProperties: false, required: ['idx', 'real'], properties: { idx: { type: 'integer' }, real: { type: 'boolean' }, reachable: { type: 'boolean' }, severity: { type: 'string', enum: ['HIGH', 'MED', 'LOW'] }, reason: { type: 'string' } } } } } }
  const dbatches = []
  for (let i = 0; i < dfresh.length; i += VERIFY_BATCH) dbatches.push(dfresh.slice(i, i + VERIFY_BATCH))
  const dverd = await parallel(dbatches.map((batch, bi) => () =>
    agent(
      `Adversarial verify in repo ${repoPath}. For EACH claim, READ the code and try HARD to REFUTE. Set real=true ONLY if ALL hold: (1) CONFIRMED FROM SOURCE; (2) REACHABLE IN PRODUCTION — the symbol is constructed/called from a non-test entrypoint (grep callers; if dead/test-only set real=false, reachable=false); (3) NOT SPEC-CORRECT BEHAVIOR — for protocol/security/interop claims the behavior is actually wrong vs spec AND a fix wouldn't break conformance. Default real=false. reason = deciding evidence.\n\nClaims:\n` +
      batch.map((f, j) => `[idx ${j}] (${f.severity} ${f.dimension}) ${f.file}:${f.line} — ${f.title}\n   what: ${f.what}\n   why: ${f.why}`).join('\n') + TERSE,
      { label: `verify-batch-${bi}`, phase: 'Verify', model: M.verify, schema: dVB }).catch(() => ({ verdicts: [] }))
      .then((r) => (((r && r.verdicts) || [])).map((v) => { const f = batch[v.idx]; if (!f) return null; return { ...f, severity: v.severity || f.severity, confirmed: !!v.real && v.reachable !== false, verdict: v.reason || '' } }).filter(Boolean))
  ))
  const dconfirmed = dverd.flat().filter((f) => f.confirmed).sort((a, b) => drank[a.severity] - drank[b.severity])
  log(`deepOnly verified: ${dconfirmed.length} new confirmed`)

  phase('Report')
  const dsev = (s) => dconfirmed.filter((f) => f.severity === s).length
  await writeReportIncremental({
    path: `${repoPath}/report-deepwaves.md`,
    items: dconfirmed,
    headerPrompt:
      `Write the START of a Markdown DELTA audit report to ${repoPath}/report-deepwaves.md using the Write tool (create/overwrite). These are NEW findings from a DeepWaves-only re-hunt on top of a prior audit of ${seed.length} findings. Write ONLY:\n` +
      `# DeepWaves Delta — <repo basename>\nSupplements the prior ${seed.length}-finding audit · ${dconfirmed.length} new · ${dsev('HIGH')} HIGH / ${dsev('MED')} MED / ${dsev('LOW')} LOW\n\n## Findings\n\n`,
    fmtItem: `### [SEV] <title> · \`<dimension>\` · area: <area>\n- **Where:** \`<file>:<line>\`\n- **What:** <what>\n- **Why it matters:** <why>\n- **Fix:** <fix>`,
  })

  const dby = (k) => dconfirmed.reduce((m, f) => ((m[f[k]] = (m[f[k]] || 0) + 1), m), {})
  return {
    mode: 'deepOnly',
    reportPath: `${repoPath}/report-deepwaves.md`,
    priorFindings: seed.length,
    newConfirmed: dconfirmed.length,
    totals: { HIGH: dconfirmed.filter((f) => f.severity === 'HIGH').length, MED: dconfirmed.filter((f) => f.severity === 'MED').length, LOW: dconfirmed.filter((f) => f.severity === 'LOW').length },
    byDimension: dby('dimension'), byArea: dby('area'),
    findings: dconfirmed,
  }
}

// ---- Recon --------------------------------------------------------------
// First, cheaply size the repo so recon knows how hard to map.
phase('Recon')
const sizeProbe = await agent(
  `Quickly size the repository at ${repoPath}: approximate total source LOC, file count, and number of distinct subsystems/top-level modules (exclude vendored/generated/node_modules/.git). Use shell (cloc/find/wc). One line per metric.`,
  { label: 'size-probe', phase: 'Recon', model: M.probe,
    schema: { type: 'object', additionalProperties: false, required: ['loc', 'sizeClass'],
      properties: { loc: { type: 'integer' }, files: { type: 'integer' }, subsystems: { type: 'integer' },
        sizeClass: { type: 'string', enum: ['small', 'medium', 'large'] } } } }).catch(() => ({ loc: 0, sizeClass: 'medium' }))
const big = sizeProbe.sizeClass === 'large'
log(`Size: ~${sizeProbe.loc} LOC → ${sizeProbe.sizeClass}${big ? ' (deep structural map first)' : ''}`)

const recon = await agent(
  `You are auditing the repository at ${repoPath} (~${sizeProbe.loc} LOC, ${sizeProbe.sizeClass}). Map it for a multi-agent audit.
Detect the full tech stack, frameworks, build tooling. State what this PRODUCT is (one phrase, for the reference search).
List the stack-specific best-practice and project-layout rules to judge structure against. Set sizeClass.
Partition the codebase into INDEPENDENT, FOCUSED audit areas (by package/module/subsystem). Each area must be small enough for one agent to audit deeply — split large directories into multiple focused areas; aim for areas under ~3k LOC each. Tag each area's importance (critical/high/normal) by how central it is (entrypoints, data plane, auth, persistence = critical). Cover the whole repo; exclude vendored/generated.
ENUMERATE EVERY MODULE/SUBPROJECT — do NOT partition only the primary/root module. Shell out to find ALL build roots and deployment surfaces and create a FOCUSED area for each one (a separate go.mod = a separate module = its own area): run e.g. \`find ${repoPath} -name go.mod -not -path '*/vendor/*'\`, and look for package.json / Cargo.toml / pyproject.toml workspaces, plus deployment dirs — Dockerfile* / docker-compose* / k8s/ operators / Helm charts (chart/, helm/) / deploy/. These secondary modules and deployment surfaces are exactly what gets dropped; they MUST each appear as their own area. When stackGuidance (below) names specific subsystems/dirs as critical audit targets, those MUST appear as their own areas tagged importance "critical".` +
  (stackGuidance ? `\n\nStack-specific guidance (treat any subsystems/dirs it flags as critical as MUST-create critical areas):\n${stackGuidance}` : ``) +
  (big
    ? `\n\nThis is a LARGE repo. FIRST build a visual map and write it to ${repoPath}/AUDIT-MAP.md (Write tool): a Mermaid \`graph\`/\`flowchart\` of the major subsystems and their dependencies, plus a table of the audit areas (key · path · importance · ~LOC · why it matters). Set mapPath to that file. The area partition must match the map so each section is tackled in focus.`
    : ``),
  { label: 'recon-map', phase: 'Recon', agentType: 'feature-dev:code-explorer', model: M.recon, schema: RECON })
// focused-section ordering: critical/high areas first
const impRank = { critical: 0, high: 1, normal: 2 }
// Pinned areas survive the fan-out cap even as lower-importance overflow: any
// deployment/operator/multi-module surface (these are exactly what recon used to
// drop — operator+Docker got ZERO coverage on a real run) OR anything recon
// tagged `critical`. Match on path + key + desc so a Dockerfile/k8s/Helm/operator
// area can't be silently culled.
const DEPLOY_RE = /(^|\/)(dockerfile|docker-compose|compose\.ya?ml)|(^|\/)(k8s|kubernetes|chart|charts|helm|deploy|deployment|operator)(\/|$)|operator/i
const isPinned = (a) => a.importance === 'critical' ||
  DEPLOY_RE.test(`${a.path || ''} ${a.key || ''} ${a.desc || ''}`)
const impRankPinned = (a) => (isPinned(a) ? -1 : (impRank[a.importance] ?? 2))
const allAreas = recon.areas.slice().sort((a, b) => impRankPinned(a) - impRankPinned(b))
// cap to keep finder fan-out (areas × passes) bounded; drop lowest-importance
// NON-PINNED overflow first — pinned (deployment/operator/critical) areas are
// always kept even if that pushes total over MAX_AREAS.
const pinned = allAreas.filter(isPinned)
const unpinned = allAreas.filter((a) => !isPinned(a))
const areas = pinned.concat(unpinned).slice(0, Math.max(MAX_AREAS, pinned.length))
const droppedAreas = allAreas.filter((a) => !areas.includes(a))
if (pinned.length) log(`Pinned (kept past cap): ${pinned.map((a) => a.key).join(', ')}`)
if (droppedAreas.length) log(`NOTE: ${allAreas.length} areas found, auditing ${areas.length} (fan-out cap); dropped lower-importance non-pinned: ${droppedAreas.map((a) => a.key).join(', ')}. Re-run with maxFinderAgents higher or scope repoPath to a subsystem to cover the rest.`)
if (recon.mapPath) log(`Visual map written: ${recon.mapPath}`)
log(`Recon: ${recon.stack} — ${areas.length}/${allAreas.length} focused areas, product="${recon.productType}", ${passes} passes → ~${areas.length * passes} finder agents`)

// --- Load resume cache (cross-session) -----------------------------------
const CSCAN = {
  type: 'object', additionalProperties: false, required: ['cells'],
  properties: {
    cells: { type: 'array', items: { type: 'object', additionalProperties: false, required: ['key', 'findings'],
      properties: { key: { type: 'string' }, findings: { type: 'array', items: { type: 'object' } } } } },
    verdicts: { type: 'array', items: { type: 'object', additionalProperties: false, required: ['key', 'real'],
      properties: { key: { type: 'string' }, real: { type: 'boolean' }, severity: { type: 'string' }, reason: { type: 'string' } } } },
  },
}
let cachedFindings = [], doneCells = new Set(), cachedVerdicts = {}
if (resume) {
  const c = await agent(
    `Resume scan. If dir ${CACHE} exists: (1) for EACH file ${CACHE}/findings/*.json, read it and return a cell {key: <filename without .json>, findings: <the JSON array in the file>}. (2) if ${CACHE}/verdicts.json exists, read it and return its array as "verdicts" (items {key, real, severity, reason}). If ${CACHE} or a subpath is missing, return empty arrays — do NOT error. Use ls + Read.`,
    { label: 'resume-scan', phase: 'Recon', model: M.probe, schema: CSCAN }).catch(() => ({ cells: [], verdicts: [] }))
  for (const cell of c.cells || []) { doneCells.add(cell.key); cachedFindings.push(...(cell.findings || [])) }
  for (const v of c.verdicts || []) cachedVerdicts[v.key] = v
  if (doneCells.size || Object.keys(cachedVerdicts).length)
    log(`Resume: reused ${doneCells.size} finder cells (${cachedFindings.length} findings) + ${Object.keys(cachedVerdicts).length} verdicts from ${CACHE}`)
}

// ---- Reference scan (parallel web search) -------------------------------
phase('Reference')
const reference = (await agent(
  `Search the web for the official, canonical, or most popular open-source implementation(s) of this product class: "${recon.productType}" (stack: ${recon.stack}).
Produce an expected-behavior + feature checklist a correct implementation must satisfy, each item with a source URL (spec, RFC, official docs, or reference repo). Focus on things AI-written clones commonly get wrong or omit.`,
  { label: 'reference-scan', phase: 'Reference', model: M.reference, schema: REFERENCE })
  .catch(() => null)) || { checklist: [], sources: [] }

const ctxFor = (lens) =>
  `Repo: ${repoPath}\nStack: ${recon.stack}\nIdiom rules: ${recon.idiomRules || 'standard for the stack'}` +
  (stackGuidance && (lens.key === 'structure' || lens.key === 'bugs' || lens.key === 'slop')
    ? `\nStack-specific best-practice guidance (judge against THIS):\n${stackGuidance}` : '') +
  (lens.key === 'gaps' || lens.key === 'structure'
    ? `\nReference checklist:\n${reference.checklist}` : '')

// ---- Audit waves: pipeline over lenses, parallel over areas -------------
phase('Audit')
const lensWaves = selectedLenses
const raw = await pipeline(
  lensWaves,
  async (lens) => {
    // run all area finders for this lens; capture per-cell so we can persist deterministically
    const cells = await parallel(areas.map((area) => () => {
      const ck = cellKey(lens.key, area.key)
      if (resume && doneCells.has(ck)) return Promise.resolve(null)   // cached on disk — don't rerun, don't rewrite
      return agent(
        `${ctxFor(lens)}\n\nAudit ONLY area "${area.key}" (${area.path}): ${area.desc}\n` +
        `Hunt EXCLUSIVELY for this class of issue — ${lens.hunt}\n` +
        `Read the actual source. Report concrete findings with exact file path and line number. Do NOT report issues outside this dimension. If none, return an empty list.` + TERSE,
        { label: `${lens.key}:${area.key}`, phase: 'Audit', agentType: lens.agentType, model: M.finder, schema: FINDINGS })
        .then((r) => ({ ck, findings: (r.findings || []).map((f) => ({ ...f, dimension: lens.key, area: area.key })) }))
        .catch(() => ({ ck, findings: [], failed: true }))
    }))
    const freshCells = cells.filter(Boolean)
    // Only persist cells whose agent actually SUCCEEDED. Caching a failed cell as []
    // makes a later resume skip it as 'done and empty' — silently losing that area.
    const okCells = freshCells.filter((c) => !c.failed)
    // DETERMINISTIC persist: JS holds the data; one cheap agent writes the cell files.
    // No longer depends on each finder voluntarily doing a side-effect write.
    if (resume && okCells.length) {
      const fileMap = {}
      for (const c of okCells) fileMap[`${c.ck}.json`] = c.findings
      await agent(
        `Create dir ${CACHE}/findings (mkdir -p ${CACHE}/findings). Then for EACH key in this JSON object, use the Write tool to write a file at ${CACHE}/findings/<key>; the file contents must be exactly the JSON value (a findings array, may be []). Overwrite existing. JSON:\n${JSON.stringify(fileMap)}`,
        { label: `persist:${lens.key}`, phase: 'Audit', model: M.probe }).catch(() => {})
    }
    return freshCells.map((c) => c.findings)
  }
)
let found = raw.flat(2).filter(Boolean).concat(cachedFindings)

// dedup by file:line:title
const seen = new Set()
let fresh = []
for (const f of found) { const k = keyOf(f); if (!seen.has(k)) { seen.add(k); fresh.push(f) } }
log(`Audit waves: ${found.length} raw, ${fresh.length} unique`)

// ---- Deep waves: completeness re-hunt (ON BY DEFAULT) -------------------
// Runs a baseline number of cross-file/integration critic rounds even with no
// token budget set; a +Nk budget extends it up to DEEP_MAX. Disable with
// A.deepRounds = 0. This is the backstop that catches cross-file bugs the
// scoped lens×area finders structurally miss.
phase('DeepWaves')
const DEEP_ROUNDS_DEFAULT = (A.deepRounds != null) ? A.deepRounds : 2
const DEEP_MAX = 6
let dry = 0, deepRounds = 0
while (dry < 2 && deepRounds < DEEP_MAX) {
  const haveBudgetHeadroom = budget.total ? budget.remaining() > 80_000 : false
  // Always run the default rounds; beyond them, only continue while budget allows.
  if (deepRounds >= DEEP_ROUNDS_DEFAULT && !haveBudgetHeadroom) break
  deepRounds++
  const critic = await agent(
    `${areas.map((a) => `${a.key}: ${a.desc}`).join('\n')}\n\n` +
    `An audit already found ${fresh.length} issues across dimensions [${selectedLenses.map((l) => l.key).join(', ')}].
Already-found titles:\n${fresh.slice(0, 60).map((f) => `- ${f.area}/${f.dimension}: ${f.title}`).join('\n')}\n\n` +
    `Find DIFFERENT issues earlier waves missed in repo ${repoPath}. Look across all dimensions and areas, especially cross-file/integration bugs. Read source. Report concrete findings with file:line. Return empty if genuinely none remain.`,
    { label: `deep-wave`, phase: 'DeepWaves', model: M.deep, schema: FINDINGS }).catch(() => null) || { findings: [] }
  // agent() RESOLVES to null when the agent is skipped or dies on a terminal API
  // error after retries — .catch() never fires for that, so guard the value too.
  const add = ((critic && critic.findings) || []).map((f) => ({ ...f, dimension: f.dimension || 'bugs', area: f.area || 'cross' }))
    .filter((f) => { const k = keyOf(f); if (seen.has(k)) return false; seen.add(k); return true })
  if (!add.length) { dry++; continue }
  dry = 0; fresh.push(...add)
  log(`Deep wave: +${add.length} (total ${fresh.length}), ${Math.round(budget.remaining() / 1000)}k budget left`)
}

// ---- Adversarial verify (BATCHED — one agent per chunk, not per finding) -
phase('Verify')
const rank = { HIGH: 0, MED: 1, LOW: 2 }
fresh.sort((a, b) => (rank[a.severity] ?? 3) - (rank[b.severity] ?? 3))
const toVerify = fresh.slice(0, MAX_VERIFY)
if (fresh.length > toVerify.length) log(`NOTE: verifying top ${toVerify.length}/${fresh.length} findings by severity (cap). Lower-severity remainder kept as candidate-only.`)
// resume: skip findings already verified in a prior run
const needVerify = toVerify.filter((f) => !cachedVerdicts[keyOf(f)])
const preConfirmed = toVerify
  .map((f) => { const v = cachedVerdicts[keyOf(f)]; return v ? { ...f, severity: v.severity || f.severity, confirmed: !!v.real, verdict: v.reason || '' } : null })
  .filter(Boolean)
if (preConfirmed.length) log(`Resume: ${preConfirmed.length} findings already verified, skipping`)
// chunk into batches; each batch = one skeptic agent that refutes every item
const batches = []
for (let i = 0; i < needVerify.length; i += VERIFY_BATCH) batches.push(needVerify.slice(i, i + VERIFY_BATCH))
log(`Verify: ${needVerify.length} new findings in ${batches.length} batches (+${preConfirmed.length} cached)`)
const VBATCH = {
  type: 'object', additionalProperties: false, required: ['verdicts'],
  properties: { verdicts: { type: 'array', items: {
    type: 'object', additionalProperties: false, required: ['idx', 'real'],
    properties: { idx: { type: 'integer' }, real: { type: 'boolean' },
      reachable: { type: 'boolean' },
      severity: { type: 'string', enum: ['HIGH', 'MED', 'LOW'] }, reason: { type: 'string' } } } } },
}
const verdictBatches = await parallel(batches.map((batch, bi) => () =>
  agent(
    `Adversarial verify in repo ${repoPath}. For EACH claim below, READ the actual code and try HARD to REFUTE it. Return a verdict per claim by idx. Set real=true ONLY if ALL THREE hold; otherwise real=false:\n` +
    ` 1. CONFIRMED FROM SOURCE — you opened the file and the described defect is actually present (not a misread, not already handled nearby).\n` +
    ` 2. REACHABLE IN PRODUCTION — the affected function/type/field is constructed or called from a real (non-test) entrypoint. grep for its constructor and callers (e.g. NewX, the method/field name) and confirm at least one caller OUTSIDE *_test.go. If it is only referenced by tests, never instantiated, or otherwise dead/unreachable code, set real=false and reachable=false — dead code is a separate 'bloat' concern, NOT a live bug/security finding.\n` +
    ` 3. NOT SPEC-CORRECT BEHAVIOR — for protocol/security/interop claims, the current behavior must actually be WRONG versus the protocol spec or the reference implementation, AND changing it must not break documented or conformance-tested behavior. If the flagged behavior is actually allowed/correct per the spec (e.g. anonymous access a protocol permits, a sentinel a spec defines), set real=false.\n` +
    `Default real=false whenever you cannot positively confirm all three. Set reachable=false when criterion 2 fails. Adjust severity if warranted. Put the deciding evidence (caller found / spec citation / why refuted) in reason.\n\nClaims:\n` +
    batch.map((f, j) => `[idx ${j}] (${f.severity} ${f.dimension}) ${f.file}:${f.line} — ${f.title}\n   what: ${f.what}\n   why: ${f.why}`).join('\n') + TERSE,
    { label: `verify-batch-${bi}`, phase: 'Verify', model: M.verify, schema: VBATCH }).catch(() => ({ verdicts: [] }))
    .then((r) => (((r && r.verdicts) || [])).map((v) => {
      const f = batch[v.idx]; if (!f) return null
      // A finding is confirmed only if it is real AND not flagged unreachable
      // (dead code) by the verifier — see verify criteria 2/3.
      return { ...f, severity: v.severity || f.severity, confirmed: !!v.real && v.reachable !== false, verdict: v.reason || '' }
    }).filter(Boolean))
))
const newlyVerified = (verdictBatches || []).flat().filter((f) => f && f.file)
const allVerified = preConfirmed.concat(newlyVerified)
// persist verdicts for cross-session resume (merge with cached)
if (resume && newlyVerified.length) {
  const merged = Object.assign({}, cachedVerdicts)
  for (const f of allVerified) merged[keyOf(f)] = { key: keyOf(f), real: f.confirmed, severity: f.severity, reason: f.verdict }
  await agent(
    `Write this JSON array to ${CACHE}/verdicts.json (mkdir -p ${CACHE} first) using the Write tool, overwriting:\n${JSON.stringify(Object.values(merged))}`,
    { label: 'persist-verdicts', phase: 'Verify', model: M.probe }).catch(() => {})
}
const confirmed = allVerified.filter((f) => f.confirmed)
confirmed.sort((a, b) => rank[a.severity] - rank[b.severity])
log(`Verified: ${confirmed.length}/${toVerify.length} confirmed`)

// ---- Synthesize report (INCREMENTAL — no single mega-Write) -------------
// A 200+ finding report emitted as ONE Write blocks for many minutes (the model
// streams the whole blob token-by-token into a single tool call → looks like a
// hang, risks the no-output watchdog). Instead: report-init writes the header +
// summary tables, then one agent PER chunk (~15 findings) APPENDS its section.
// Appends MUST be serialized (concurrent appends to one file corrupt it) — the
// pipeline runs the chunks strictly in order. JS holds the data and hands each
// agent only its own slice so no agent ever formats the whole set.
phase('Report')
const REPORT_PATH = `${repoPath}/report.md`
const byDim = (k) => confirmed.reduce((m, f) => ((m[f[k]] = (m[f[k]] || 0) + 1), m), {})
const sevCount = (arr, s) => arr.filter((f) => f.severity === s).length
// by-dimension table: selected lenses first, then any extra dims (e.g. DeepWaves 'cross')
const dimTable = selectedLenses.map((l) => l.key)
  .concat([...new Set(confirmed.map((f) => f.dimension))].filter((d) => !selectedLenses.some((l) => l.key === d)))
const dimRows = dimTable.map((d) => {
  const sub = confirmed.filter((f) => f.dimension === d)
  return `| ${d} | ${sevCount(sub, 'HIGH')} | ${sevCount(sub, 'MED')} | ${sevCount(sub, 'LOW')} |`
}).join('\n')
const areaCounts = byDim('area')
const areaRows = Object.keys(areaCounts).sort().map((a) => `| ${a} | ${areaCounts[a]} |`).join('\n')
const headerPayload = JSON.stringify({ stack: recon.stack, productType: recon.productType, areaCount: areas.length })
const gapsPayload = JSON.stringify({ reference: reference.checklist, gapsFindings: confirmed.filter((f) => f.dimension === 'gaps') })
await writeReportIncremental({
  path: REPORT_PATH,
  items: confirmed,
  // (1) report-init: header + by-dimension + by-area summary tables + the "## Findings" heading.
  headerPrompt:
    `Write the START of a Markdown audit report to ${REPORT_PATH} using the Write tool (create/overwrite). Write ONLY the header and the two summary tables below, ending right after the "## Findings" heading. Meta (JSON): ${headerPayload}\n\n` +
    `Exact structure:\n` +
    `# Audit Report — <repo basename> (<commit short-sha if \`git -C ${repoPath} rev-parse --short HEAD\` works, else omit>)\n` +
    `Stack: <stack> · Areas: ${areas.length} · Findings: ${sevCount(confirmed, 'HIGH')} HIGH / ${sevCount(confirmed, 'MED')} MED / ${sevCount(confirmed, 'LOW')} LOW\n\n` +
    `## Summary by dimension\n\n| Dimension | HIGH | MED | LOW |\n|---|---|---|---|\n${dimRows}\n\n` +
    `## Summary by area\n\n| Area | Findings |\n|---|---|\n${areaRows}\n\n` +
    `## Findings\n\n`,
  // (2) per-chunk append agents (serialized; HIGH→MED→LOW order preserved by `confirmed`).
  fmtItem: `### [SEV] <title> · \`<dimension>\` · area: <area>\n- **Where:** \`<file>:<line>\`\n- **What:** <what>\n- **Why it matters:** <why>\n- **Fix:** <fix>\n- **Verified:** <verdict>`,
  // (3) final tail agent appends the gaps-vs-reference section.
  tail: { prompt:
    `APPEND a final "## Implementation gaps vs reference" section to the END of the EXISTING file ${REPORT_PATH} (Read it, then Write it back with this section appended — do NOT overwrite existing content). Build a table (expected behavior → our behavior → gap → source URL) from the reference checklist plus any \`gaps\` findings. Data (JSON):\n${gapsPayload}\n\n` +
    `Add only this one section. Confirm the path after writing.` + TERSE },
})

// summary back to the orchestrator
const by = (k) => confirmed.reduce((m, f) => ((m[f[k]] = (m[f[k]] || 0) + 1), m), {})
return {
  reportPath: `${repoPath}/report.md`,
  stack: recon.stack, productType: recon.productType,
  areas: areas.map((a) => a.key),
  passesRun: passes,
  totals: { HIGH: confirmed.filter((f) => f.severity === 'HIGH').length, MED: confirmed.filter((f) => f.severity === 'MED').length, LOW: confirmed.filter((f) => f.severity === 'LOW').length },
  byDimension: by('dimension'), byArea: by('area'),
  findings: confirmed,
}
